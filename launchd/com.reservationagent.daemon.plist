<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.reservationagent.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python</string>
        <string>-m</string>
        <string>reservation_agent</string>
        <string>--config</string>
        <string>/Users/rsarkar/reservation-agent/config/config.yaml</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/rsarkar/reservation-agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/rsarkar/reservation-agent/src</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rsarkar/reservation-agent/data/logs/daemon.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/rsarkar/reservation-agent/data/logs/daemon.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
